{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build puppet-show debugger", "type": "shell",
      "command": "npm run build:webview && npm --prefix vscode run build", "problemMatcher": []
    },
    {
      "label": "puppet-show dev server", "type": "shell",
      "command": "npm run dev -- --port 5173 --strictPort",
      "isBackground": true,
      "problemMatcher": {
        "owner": "puppet-show-vite", "pattern": {"regexp": "^(?!x)x(.+):(\\d+):(.+)$", "file": 1, "line": 2, "message": 3},
        "background": {"activeOnStart": true, "beginsPattern": "vite", "endsPattern": "Local:.*5173"}
      }
    }
  ]
}
